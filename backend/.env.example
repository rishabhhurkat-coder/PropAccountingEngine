# Copy this file to .env and fill in values locally.
# Never commit .env or any decrypted credential file.

# ==================== SUPABASE ====================
SUPABASE_HOST=
SUPABASE_PORT=5432
SUPABASE_DATABASE=postgres
SUPABASE_USER=
SUPABASE_PASSWORD=
SUPABASE_SSLMODE=require

# ==================== WEB ACCESS ====================
# The Prop backend owns its own session boundary and authenticates against the
# shared workspace Users table. These Supabase Auth settings remain available
# for compatibility with existing deployments and future auth migration.
SUPABASE_AUTH_URL=https://YOUR_PROJECT.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
# Comma-separated email addresses approved for this shared workspace.
# Leave empty only in local development; production fails closed when it is empty.
APP_ALLOWED_EMAILS=
# Include the public application URL and local development origin.
CORS_ORIGINS=https://hnlsoftware.in,http://localhost:3489,http://127.0.0.1:3489
PUBLIC_APP_ORIGIN=https://hnlsoftware.in

# ==================== GCS ====================
GCS_SERVICE_ACCOUNT_JSON=
GCS_BUCKET_NAME=
GCS_CONFIG_PATH=config

# ==================== ZERODHA ====================
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_ACCESS_TOKEN=
ZERODHA_INSTRUMENTS_FILE=../Other Logs/instruments.csv
ZERODHA_GCS_CONFIG_PATH=config
ZERODHA_AUTO_VALIDATE=true
ZERODHA_BROWSER_LOGIN=true
ZERODHA_TIMEOUT=30
ZERODHA_MAX_RETRY=3
ZERODHA_DOWNLOAD_INSTRUMENTS=true
ZERODHA_WEBSOCKET_MODE=auto
# Backend-owned polling keeps CMP values updated even when no browser is open.
ZERODHA_BACKGROUND_UPDATES=true
ZERODHA_BACKGROUND_UPDATE_INTERVAL_SECONDS=5

# ==================== MARTINGALE ====================
MARTINGALE_ENABLED=false

# ==================== JOBBER / MATALIA ====================
JOBBER_BASE_URL=https://jobber.matalia.co.in
JOBBER_USERNAME=
JOBBER_PASSWORD=
JOBBER_CLIENT=
JOBBER_EXCHANGE=BNF
JOBBER_BSE_EXCHANGE=BSE
JOBBER_FETCH_WORKERS=3
